package templates

// ErrorInline renders an error message as an HTMX-swappable fragment.
// Used for inline error responses from form submissions.
templ ErrorInline(message string) {
	@Toast(message, ToastError)
}

// CSRFError renders a CSRF validation error with a script that
// updates the HTMX CSRF header from the fresh cookie so the
// next request succeeds without a page refresh.
templ CSRFError() {
	@FormError("Invalid CSRF token. Please try again.")
	<script>
		var c = document.cookie.split('; ').find(function(r) { return r.startsWith('csrf_token='); });
		if (c) { document.body.setAttribute('hx-headers', JSON.stringify({'X-CSRF-Token': c.substring('csrf_token='.length)})); }
	</script>
}

// ErrorPage renders a full-page error (404, 500, etc.)
templ ErrorPage(code string, message string, version string) {
	@Layout(LayoutProps{Title: message + " — Sharm", Version: version}) {
		<div style="text-align:center;padding:var(--s-2xl) 0;">
			<p style="font-size:var(--text-2xl);font-weight:600;font-family:var(--font-mono);color:var(--text-muted);margin-bottom:var(--s-sm);">{ code }</p>
			<p style="font-size:var(--text-base);color:var(--text-secondary);margin-bottom:var(--s-lg);">{ message }</p>
			<a href="/" class="button-outline">Back to home</a>
		</div>
	}
}
